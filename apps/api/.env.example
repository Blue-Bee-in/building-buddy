# Server
PORT=8080

# Database (DigitalOcean Managed Postgres)
DATABASE_URL=postgres://postgres:password@localhost:5432/building_buddy?sslmode=disable

# Auth
JWT_SECRET=change-me-to-a-random-32-char-string-in-production
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-char-string

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# DigitalOcean Spaces (S3-compatible — for invoice PDFs)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=building-buddy
DO_SPACES_REGION=blr1
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com

# WhatsApp (choose one: twilio or gupshup)
WHATSAPP_PROVIDER=twilio
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# Firebase Cloud Messaging (push notifications)
FCM_SERVER_KEY=

# River Worker
RIVER_MAX_WORKERS=10
BILLING_QUEUE_MAX_WORKERS=5
